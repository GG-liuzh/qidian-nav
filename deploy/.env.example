# Used only for the application's Host/Origin allowlist.
# Domains, certificates and the reverse proxy are managed manually in 1Panel.
# Domain only: no https://, port, path, or trailing slash.
NAV_DOMAIN=nav.example.com

# Keep this value unchanged after the first deployment: it names the data volumes.
# Existing installs: keep their original project name (often "deploy").
COMPOSE_PROJECT_NAME=qidian-nav

NAV_IMAGE=qidian-nav:latest
NAV_REGISTRATION_ENABLED=false
NAV_SESSION_HOURS=12

# Application HTTP listener on the Docker host.
NAV_WEB_BIND=127.0.0.1
NAV_WEB_PORT=4180

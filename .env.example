# Relative filesystem paths are resolved from the project root, not the shell directory.
# These match the built-in defaults; copying this file is optional for local development.
TEAM_NAV_DATABASE_URL=sqlite:///.runtime/team-nav.db
TEAM_NAV_KEY_FILE=.runtime/secrets/credential.key
TEAM_NAV_SETUP_TOKEN_FILE=.runtime/secrets/setup-token
TEAM_NAV_FRONTEND_DIST=frontend/dist

# Use a dedicated PostgreSQL database for a team deployment:
# TEAM_NAV_DATABASE_URL=postgresql+psycopg://team_nav@127.0.0.1:5432/team_nav
# TEAM_NAV_DATABASE_PASSWORD_FILE=.runtime/secrets/db-password
TEAM_NAV_ORIGINS=http://127.0.0.1:4180,http://localhost:4180,http://127.0.0.1:5173,http://localhost:5173
TEAM_NAV_ALLOWED_HOSTS=127.0.0.1,localhost
TEAM_NAV_SECURE_COOKIES=false
TEAM_NAV_ENVIRONMENT=development
TEAM_NAV_REGISTRATION_ENABLED=true

# Internet deployment: use production, HTTPS origins, explicit allowed hosts,
# secure cookies, and keep rate limiting enabled. The Docker template sets these.
# Set registration_enabled=false to require invitations for new accounts.
